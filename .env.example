# ---------------------------------------------------------------------------
# Database
# Leave DATABASE_URL unset to run on an embedded local Postgres (PGlite), which
# auto-creates, migrates and seeds itself under .data/pgdata on first boot.
# To use Supabase, paste the Postgres connection string from
# Project Settings -> Database -> Connection string -> URI.
# The same supabase/migrations/*.sql runs against either.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Admin panel — per-user accounts (admin_users table), not a shared password.
SESSION_SECRET=generate-a-long-random-string-at-least-32-chars

# Optional: pin the first Super Admin's email/password instead of getting a
# generated one printed to the console on first boot. Only used the very
# first time admin_users is empty.
# SEED_SUPER_ADMIN_EMAIL=you@example.com
# SEED_SUPER_ADMIN_PASSWORD=set-a-temporary-password

# Payments: "mock" auto-approves. "stripe" is stubbed until keys are wired.
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
